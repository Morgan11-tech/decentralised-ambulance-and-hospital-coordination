{
  "$defs": {
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "incident_type": {
          "$ref": "#/$defs/IncidentTypeLabel"
        },
        "severity": {
          "$ref": "#/$defs/SeverityLabel"
        },
        "consciousness_concern": {
          "$ref": "#/$defs/ConcernLabel"
        },
        "breathing_concern": {
          "$ref": "#/$defs/ConcernLabel"
        }
      },
      "required": [
        "incident_type",
        "severity",
        "consciousness_concern",
        "breathing_concern"
      ],
      "title": "Classification",
      "type": "object"
    },
    "ConcernLabel": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "yes",
            "no",
            "uncertain"
          ],
          "title": "Value",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Classifier confidence 0..1; null when no confidence exists (classifier unavailable, or synthetic data).",
          "title": "Confidence"
        }
      },
      "required": [
        "value",
        "confidence"
      ],
      "title": "ConcernLabel",
      "type": "object"
    },
    "IncidentDetails": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "One short factual sentence about what happened.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "mechanism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How it happened, e.g. 'bicycle fall'; null if not applicable/known.",
          "title": "Mechanism"
        },
        "type": {
          "enum": [
            "cardiac_or_circulatory",
            "respiratory",
            "trauma",
            "neurological",
            "bleeding",
            "other",
            "uncertain"
          ],
          "title": "Type",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "urgent",
            "non_urgent",
            "uncertain"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "description",
        "mechanism",
        "type",
        "severity"
      ],
      "title": "IncidentDetails",
      "type": "object"
    },
    "IncidentTypeLabel": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "cardiac_or_circulatory",
            "respiratory",
            "trauma",
            "neurological",
            "bleeding",
            "other",
            "uncertain"
          ],
          "title": "Value",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Classifier confidence 0..1; null when no confidence exists (classifier unavailable, or synthetic data).",
          "title": "Confidence"
        }
      },
      "required": [
        "value",
        "confidence"
      ],
      "title": "IncidentTypeLabel",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Location as described, e.g. 'Vrijhof, University of Twente'.",
          "title": "Raw Text"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        }
      },
      "required": [
        "raw_text",
        "latitude",
        "longitude"
      ],
      "title": "Location",
      "type": "object"
    },
    "PatientCondition": {
      "additionalProperties": false,
      "properties": {
        "consciousness": {
          "default": "unknown",
          "enum": [
            "conscious",
            "unconscious",
            "unknown"
          ],
          "title": "Consciousness",
          "type": "string"
        },
        "breathing": {
          "default": "unknown",
          "enum": [
            "normal",
            "abnormal",
            "not_breathing",
            "unknown"
          ],
          "title": "Breathing",
          "type": "string"
        },
        "severe_bleeding": {
          "default": "unknown",
          "description": "present = heavy or uncontrolled bleeding reported.",
          "enum": [
            "present",
            "absent",
            "unknown"
          ],
          "title": "Severe Bleeding",
          "type": "string"
        },
        "symptoms": {
          "description": "Observations in plain words, e.g. 'head injury', 'left arm weakness'. Never diagnoses.",
          "items": {
            "type": "string"
          },
          "title": "Symptoms",
          "type": "array"
        }
      },
      "required": [
        "consciousness",
        "breathing",
        "severe_bleeding",
        "symptoms"
      ],
      "title": "PatientCondition",
      "type": "object"
    },
    "Patients": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of patients; null if unknown.",
          "title": "Count"
        },
        "primary_patient": {
          "$ref": "#/$defs/PatientCondition",
          "description": "The patient described, or the most seriously affected one when there are several."
        }
      },
      "required": [
        "count",
        "primary_patient"
      ],
      "title": "Patients",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "entrapment": {
          "default": "unknown",
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_relevant"
          ],
          "title": "Entrapment",
          "type": "string"
        },
        "immediate_danger": {
          "default": "unknown",
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_relevant"
          ],
          "title": "Immediate Danger",
          "type": "string"
        }
      },
      "required": [
        "entrapment",
        "immediate_danger"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SeverityLabel": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "critical",
            "urgent",
            "non_urgent",
            "uncertain"
          ],
          "title": "Value",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Classifier confidence 0..1; null when no confidence exists (classifier unavailable, or synthetic data).",
          "title": "Confidence"
        }
      },
      "required": [
        "value",
        "confidence"
      ],
      "title": "SeverityLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical incident payload consumed by the Multi-Agent System.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "incident_id": {
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Voice session id; null for synthetic incidents.",
      "title": "Session Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source": {
      "enum": [
        "voice_agent",
        "synthetic_generator"
      ],
      "title": "Source",
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "incident": {
      "$ref": "#/$defs/IncidentDetails"
    },
    "patients": {
      "$ref": "#/$defs/Patients"
    },
    "scene": {
      "$ref": "#/$defs/Scene"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "status": {
      "const": "ready_for_dispatch",
      "default": "ready_for_dispatch",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "incident_id",
    "session_id",
    "created_at",
    "source",
    "location",
    "incident",
    "patients",
    "scene",
    "classification",
    "status"
  ],
  "title": "Incident",
  "type": "object"
}
