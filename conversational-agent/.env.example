# Copy to .env (same folder) and fill in the credentials.
# Only the backend reads this file; no key ever reaches the browser.

# --- Credentials -------------------------------------------------------------
# Deepgram console -> API Keys
DEEPGRAM_API_KEY=
# Google AI Studio -> Get API key
GEMINI_API_KEY=
# TypeSafe console (https://console.typesafe.ai/keys)
JEV_API_KEY=
# Local MongoDB from docker-compose.yml (docker compose up -d):
MONGODB_URI=mongodb://localhost:27017
# ...or MongoDB Atlas instead, e.g. mongodb+srv://user:password@cluster.xxxxx.mongodb.net/

# --- Classification -----------------------------------------------------------
JEV_CONFIDENCE_THRESHOLD=0.70
MAX_CLASSIFICATION_CLARIFICATIONS=1

# --- Models (defaults shown; see README "Models") ---------------------------------
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
DEEPGRAM_STT_MODEL=flux-general-en

# --- MongoDB -------------------------------------------------------------------
MONGODB_DATABASE=emergency_voice_agent
MONGODB_INCIDENT_COLLECTION=incidents

# --- Web -----------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# --- Optional tuning (defaults shown) -------------------------------------------------
# GEMINI_THINKING_LEVEL=low          # low | medium | high (gemini-3.8-flash has no "minimal")
# GEMINI_TTS_VOICE=Kore
# DEEPGRAM_KEYTERMS=University of Twente,Twente,Enschede,Hengelo   # words Deepgram should listen for
# JEV_MODEL=jev-latest               # pin e.g. jev-1.13.0 once thresholds are tuned
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
